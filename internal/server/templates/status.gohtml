<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Spark Job Status</title>
{{- if .RefreshSeconds}}
<meta http-equiv="refresh" content="{{.RefreshSeconds}}">
{{- end}}
<style>
  body { font-family: sans-serif; margin: 2em; }
  .message { font-size: 1.1em; margin: 1em 0; }
  a { color: #1565c0; }
  #countdown { font-weight: bold; }
</style>
</head>
<body>
<h1>Spark Job: {{.AppName}}</h1>
<p class="message">{{.Message}}</p>
{{- if .HistoryURL}}
<p><a href="{{.HistoryURL}}">View in Spark History Server</a></p>
{{- else if .WakeURL}}
<p><a href="{{.WakeURL}}">Start Spark History Server and view job</a></p>
{{- end}}
{{- if .RefreshSeconds}}
<p>This page will refresh in <span id="countdown">{{.RefreshSeconds}}</span> seconds.</p>
<script>
(function () {
  var el = document.getElementById("countdown");
  var remaining = {{.RefreshSeconds}};
  var interval = setInterval(function () {
    remaining -= 1;
    el.textContent = remaining;
  }, 1000);
})();
</script>
{{- end}}
<p><a href="/proxy/">Back to dashboard</a></p>
</body>
</html>
